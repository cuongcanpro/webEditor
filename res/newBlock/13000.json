{
    "description": "Mèo ẩn thân (state VISIBLE, 2x2): nhận side-match damage bình thường (HP=4). Đếm turnCount mỗi endTurn; khi turnCount == 2 → action_0 reset turnCount=0 rồi ReplaceSelfAction sang ID 13001 (hidden). Reset bắt buộc vì customData sống sót qua ReplaceSelf.",
    "dedupPerMatch": true,
    "baseAction": [],
    "unblockAction": [],
    "customAction": {
        "sideMatch": [
            "TakeDamageAction"
        ],
        "match": [
            "TakeDamageAction"
        ],
        "endTurn": [
            {
                "name": "ChangeAttributeAction",
                "config": {
                    "fieldName": "turnCount",
                    "delta": 1,
                    "defaultValue": 0
                }
            },
            {
                "name": "CheckAttributeAction",
                "config": {
                    "fieldName": "turnCount",
                    "targetValue": 2,
                    "actionKey": "action_0"
                }
            }
        ],
        "action_0": [
            {
                "name": "ChangeAttributeAction",
                "config": {
                    "fieldName": "turnCount",
                    "setValue": 0
                }
            },
            {
                "name": "ReplaceSelfAction",
                "config": {
                    "type": 13001,
                    "refillAfterSwap": true
                }
            }
        ]
    },
    "visual": {
        "path": "res/newBlock/BlockUI/spine/cat/hidden_cat.png",
        "type": 0,
        "uiClass": "CatHiddenUI"
    },
    "type": "Blocker",
    "width": 2,
    "height": 2,
    "layerBehavior": "EXCLUSIVE",
    "configData": {
        "hitPoints": 4,
        "maxHP": 4
    }
}